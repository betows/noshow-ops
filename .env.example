# Stripe (server)
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe (browser contract — hosted Checkout uses the secret key server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Recurring Price: $2,500 USD / month (create via Dashboard or npm run stripe:create-price)
STRIPE_PRICE_ID=price_replace_me

# Canonical site URL used for Checkout success/cancel redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
